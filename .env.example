# ─────────────────────────────────────────────────────────────────────────────
# ECV Base environment. Copy to .env for local development.
# Production and development use SEPARATE Supabase projects (EU / Frankfurt).
# See docs/deployment.md for where to find each value.
# ─────────────────────────────────────────────────────────────────────────────

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=ECV Base
# Live locales (comma-separated). Add "de" once German UI strings and content are reviewed.
NEXT_PUBLIC_LOCALES=en
# Set to "production" only on the production deployment if not on Vercel (Vercel sets VERCEL_ENV).
# SITE_ENV=production

# Payload
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Database (Supabase Postgres)
# Runtime: Supabase "Transaction pooler" URI (port 6543), without ?sslmode=...
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ecvbase
# Migrations: "Session pooler" or direct URI (port 5432). Optional; falls back to DATABASE_URL.
# DATABASE_MIGRATE_URL=
# TLS: paste Supabase's root CA (Settings → Database → SSL) to verify, or use no-verify as a fallback.
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# DATABASE_SSL=no-verify
# DATABASE_POOL_MAX=5
# Set to false on shared databases so only migrations change the schema.
# PAYLOAD_DB_PUSH=false

# Storage (Supabase Storage, S3-compatible). Leave empty to store files on local disk in development.
# S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
# S3_REGION=eu-central-1
# S3_BUCKET=ecv-base
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Public URL of the bucket (make the bucket public):
# S3_PUBLIC_URL=https://<project-ref>.supabase.co/storage/v1/object/public/ecv-base

# Stripe (subscriptions per brand, billed per listed model per year)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_PRO=price_...
# STRIPE_AUTOMATIC_TAX=false

# Search engines
# IndexNow key (any 32 hex chars). Served at /indexnow-key.txt, pinged on publish in production.
# INDEXNOW_KEY=
# Verification tokens (optional; you can also verify via DNS)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# Email (optional; without it Payload logs emails to the console)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=no-reply@elektrischenutzfahrzeuge.de

# Seed script: first admin account
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=
